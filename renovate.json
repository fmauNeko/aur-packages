{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":rebaseStalePrs",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    ":automergeMinor",
    ":automergeDigest"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)PKGBUILD$/"],
      "matchStrings": [
        "pkgver=(?<currentValue>.*) # renovate: datasource=(?<datasource>.*) depName=(?<depName>.*) extractVersion=(?<extractVersion>.*)"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.*)${{/if}}"
    }
  ],
  "customDatasources": {
    "factorio": {
      "defaultRegistryUrlTemplate": "https://factorio.com/api/latest-releases",
      "transformTemplates": [
        "{\"releases\":[{\"version\": $$.({{packageName}})}]}"
      ]
    }
  }
}
